  public class JavaBasics{
     public static void reverse_array(int num[]){
      for(int i=0;i<num.length;i++){
        for(int j=i+1;j<num.length;j++){
          System.out.print("( "+num[i]+", "+num[j]+" )");
        }
        System.out.println();
       }
      }
