 import java.util.*;
  //hollow rhombus 

  public class JavaBasics{
      public static void butterfly(int trow){
        
        for (int r=1; r<=trow ; r++){
          
              for(int i=1;i<=(5-r);i++){
                System.out.print(" ");
              }

             for(int c=1; c<=trow ; c++){
              if(r==1||r==trow||c==1||c==trow){
                System.out.print("*");
              }
              else{
                System.out.print(" ");
              }
             }
              
              System.out.println();
            }
        }
    
      public static void main(String args[]){
        Scanner sc= new Scanner(System.in);
        System.out.print("Enter the no of rows : ");
        int trow=sc.nextInt();
        
        butterfly(trow);
      }
  }


