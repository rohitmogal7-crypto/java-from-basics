 import java.util.*;
  //passing arrays as an argument 

  public class JavaBasics{
     public static void update(int marks[]){
      for (int i=0;i<marks.length;i++){
        marks[i]=marks[i]+1;
      }

     }
      public static void main(String args[]){
       int marks[]={98,90,90};
       update(marks);
       for (int i=0;i<marks.length;i++){
        System.out.print(marks[i]+"  ");
      }
      }
  }
