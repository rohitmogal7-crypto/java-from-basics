import java.util.*;
  //floyds triangle

  public class JavaBasics{
      public static void inverted_rotated_pyramid_num(int trow){
        int a=1;
        for (int i=1; i<=trow ; i++){
          for(int c=1; c<=i;c++){
              System.out.print(" "+a+" ");
              a++;
            }
            
          System.out.println();
          }
          
        }
    
      public static void main(String args[]){
        Scanner sc= new Scanner(System.in);
        System.out.print("Enter the no of rows : ");
        int trow=sc.nextInt();
        inverted_rotated_pyramid_num(trow);
      }
  }
