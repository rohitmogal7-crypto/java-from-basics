import java.util.*;
// inverted and rotated half-pyramid

public class JavaBasics{
    public static void inverted_rotated_pryimid(int trow){
      for (int i=1; i<=trow ; i++){
        for(int c=1; c<=trow-i;c++){
             System.out.print(" ");
          }
          for(int j=1; j <= i ;j++){
            System.out.print("*");
          }
         System.out.println();
        }
        
      }
  
    public static void main(String args[]){
      Scanner sc= new Scanner(System.in);
      System.out.print("Enter the no of rows : ");
      int trow=sc.nextInt();
      inverted_rotated_pryimid(trow);
    }
}
