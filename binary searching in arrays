 import java.util.*;
  //binary searching

  public class JavaBasics{
     public static int BinarySearch(int num[],int key){
      int start=0;
      int end=num.length-1;
      while (start<=end) {
        int mid=(start+end)/2;
        if(key==num[mid]){
          return mid;
        }
        if(key>num[mid]){
          start=mid+1;
        }
        else{
          end=mid-1;
        }
      }
      return -1;
        
        
      }
      

     
     
      public static void main(String args[]){
       int num[]={1,4,6,7,8,9,11,13,44,90};
       int key=4;
       int keyat = BinarySearch(num, key);
      System.out.print("the key u are searching is at the index : "+ keyat);
       
      }
  }
