  import java.util.*;
  //diamond pattern 

  public class JavaBasics{
      public static void diamond(int trow){
        
        for (int r=1; r<=trow; r++){
          
              for(int i=1;i<=trow-r;i++){
                System.out.print(" ");
              }
              for(int s=1;s<=2*r-1;s++){
                System.out.print("*");
              }
              
              System.out.println();
            }
            for (int r=trow; r>=1 ; r--){
          
              for(int i=1;i<=trow-r;i++){
                System.out.print(" ");
              }
              for(int s=1;s<=2*r-1;s++){
                System.out.print("*");
              }
              
              System.out.println();
            }
        }
    
      public static void main(String args[]){
        Scanner sc = new Scanner(System.in);
        System.out.print("Enter the no of rows : ");
        int trow=sc.nextInt();
        
        diamond(trow);
      }
  }
