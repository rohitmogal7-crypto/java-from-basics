import java.util.*;
//multiplication

public class JavaBasics{
    
    public static void multiplication(int a,int b){
       int multi=a*b;
       System.out.println("multiplication is : "+ multi);
        return;
    }
    public static void main(String args[]){
        Scanner sc= new Scanner(System.in);
        
        
        int a =sc.nextInt();
        int b =sc.nextInt();
       multiplication(a,b);
    }
}
