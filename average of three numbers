import java.util.*;
//Write a Java method to compute the averageof three numbers.

public class JavaBasics{
     public static void average(int a,int b, int c){
        
       int avg=(a+b+c)/3;
       System.out.print(avg);
     }
        
    
    public static void main(String args[]){
      average(3,4 ,5);
    }
}
