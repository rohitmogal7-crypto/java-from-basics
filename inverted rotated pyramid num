import java.util.*;
// inverted_rotated_pyramid_num

public class JavaBasics{
    public static void inverted_rotated_pyramid_num(int trow){
      for (int i=0; i<=trow ; i++){
        for(int c=1; c<=trow-i;c++){
             System.out.print(c);
          }
          
         System.out.println();
        }
        
      }
  
    public static void main(String args[]){
      Scanner sc= new Scanner(System.in);
      System.out.print("Enter the no of rows : ");
      int trow=sc.nextInt();
      inverted_rotated_pyramid_num(trow);
    }
}
