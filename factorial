import java.util.*;
//factorial

public class JavaBasics{
    
    public static int factorial(int n){
        int fact=1;
       for(int i=1;i<=n;i++){
        fact=i*fact;
        
       }
        return fact;
    }
    public static void main(String args[]){
        Scanner sc= new Scanner(System.in);
        
        
        int n =sc.nextInt();
       
       int factorial=factorial(n);
       System.out.println("your factorial is : "+factorial);
    }
}
